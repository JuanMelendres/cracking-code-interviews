# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Java / build
target/
build/
.gradle/
*.class
*.jar
!templates/**/*.jar
*.hprof

# Env / secrets
.env
.env.*
*.pem
*.key
*.p12
*.jks
!templates/**/*.key.example

# Logs / temp
*.log
*.log.*
*.tmp
*.temp
.cache/

# Archives (extracted contents are what's tracked, not the zip itself)
*.zip
*.tar.gz
*.7z

# Recordings (mock interviews, narration drills — large, frequently unsanitised)
recordings/
*.m4a
*.mp3
*.mp4
*.mov
*.wav

# Local-only escape hatch (see CONTRIBUTING.md § Privacy)
**/local/
*.private.md

# Python (validation tooling)
__pycache__/
*.pyc
.venv/

# Node (frontend domain: practice/frontend/*)
node_modules/
dist/
test-results/
playwright-report/
blob-report/

# Claude Code local/personal settings (permissions etc.), not project content
.claude/settings.local.json

# --- explicitly NOT ignored (documented for clarity, no-op lines) ---
# *.md, *.java, *.sql, *.yml, *.yaml, *.json, *.mmd — always tracked
