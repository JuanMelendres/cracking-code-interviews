# Multi-stage build: the build stage's filesystem (Maven, the JDK,
# the .m2 cache, the source tree) is discarded entirely. Only the
# artifacts explicitly pulled forward with COPY --from=build survive
# into the final image.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY app/pom.xml .
COPY app/src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /build/target/container-image-internals-jar-with-dependencies.jar app.jar
CMD ["java", "-jar", "/app/app.jar"]
